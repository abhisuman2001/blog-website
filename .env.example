# Fill these in AFTER Google AdSense approves your site, then add them in Vercel > Settings > Environment Variables.
# At most two ads appear on any page: one in the feed / article body, and one in the article sidebar.
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_AD_SLOT_FEED=
PUBLIC_AD_SLOT_ARTICLE=
PUBLIC_AD_SLOT_SIDEBAR=
