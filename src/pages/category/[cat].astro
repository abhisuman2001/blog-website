---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getPosts, CATS } from '../../lib/sanity.js';
export function getStaticPaths() {
  return Object.keys(CATS).map((cat) => ({ params: { cat } }));
}
const { cat } = Astro.params;
const posts = (await getPosts()).filter((p) => p.cat === cat);
const name = CATS[cat];
---
<Base title={`${name} – ShipLog`} description={`Latest ${name} posts on ShipLog.`}>
  <h1 style="font-size:clamp(30px,5vw,48px);letter-spacing:-.03em;margin:20px 0">{name}</h1>
  <div class="cols">
    <main>
      {posts.length ? posts.map((p) => <PostRow p={p} />) : <p class="meta">No posts in this topic yet.</p>}
    </main>
    <aside><AdSlot name="sidebar" side /></aside>
  </div>
</Base>
