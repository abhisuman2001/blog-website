---
// A mast with a pennant: the "ship it" flag. Colours follow the theme.
const { size = 28 } = Astro.props;
---
<svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="8" fill="var(--ink)" />
  <path d="M11 7.5v17" stroke="var(--paper)" stroke-width="2.4" stroke-linecap="round" />
  <path d="M12.2 8.5h11.3l-3.4 4.25 3.4 4.25H12.2z" fill="var(--accent-bright)" />
</svg>
