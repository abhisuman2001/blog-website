---
import Logo from './Logo.astro';
import { SITE, TOPICS } from '../config.js';

// `section` lets a page highlight a nav item it lives under (e.g. a post highlights its topic).
const { section } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const links = [
  ...Object.values(TOPICS).map((t) => ({ href: `/topics/${t.slug}/`, label: t.name })),
  { href: '/archive/', label: 'Archive' },
  { href: '/about/', label: 'About' },
];
const isCurrent = (href) => path === href || section === href;
---
<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <Logo />
      <span class="wordmark">{SITE.name}</span>
    </a>

    <nav class="primary-nav" aria-label="Main">
      <ul>
        {links.map(({ href, label }) => (
          <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="search-trigger" type="button" data-search-open aria-haspopup="dialog" aria-controls="search-dialog">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="search-trigger-label">Search</span>
        <kbd data-shortcut>Ctrl K</kbd>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to dark theme">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </div>
  </div>
</header>
