---
import { CATS, fmtDate } from '../lib/sanity.js';
const { p } = Astro.props;
---
<article class={`post ${p.cat}`}>
  <div class="d">{fmtDate(p.date)}</div>
  <div>
    <span class="tag">{CATS[p.cat]}</span>
    <h3><a href={`/posts/${p.slug}/`}>{p.title}</a></h3>
    <p>{p.excerpt}</p>
  </div>
</article>
